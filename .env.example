# Localdrivers Environment Variables Example

# Turso SQLite Database Configuration (Production abstraction)
TURSO_DATABASE_URL=libsql://localdrivers-db-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Cloudflare R2 Storage Configuration (Production abstraction)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=localdrivers-media

# Admin Portal Credentials
ADMIN_USERNAME=Ranjith.ceo
ADMIN_PASSWORD=ranjith@2026

# Driver Demo Default Credentials
DEMO_DRIVER_EMAIL=ravi@localdrivers.in
DEMO_DRIVER_PASSWORD=driverpass

# Google Maps API Key (Optional fallback map provider)
VITE_GOOGLE_MAPS_API_KEY=
